# hoster as a systemd *user* service (ADR-0001, ADR-0023). See https://docs.hoster.lhelge.se/wiki/install/.
#
# Install as ~hoster/.config/systemd/user/hoster.service, then as the hoster user:
#   systemctl --user daemon-reload
#   systemctl --user edit hoster        # set HOSTER_ADMIN_GITHUB in a drop-in (see below)
#   systemctl --user enable --now hoster
# The hoster user needs linger (`loginctl enable-linger hoster`) so this starts at boot without
# a login.
#
# Logs: `journalctl --user -u hoster` as hoster, or `journalctl _SYSTEMD_USER_UNIT=hoster.service`
# as root.

[Unit]
Description=hoster deployment orchestrator
Documentation=https://docs.hoster.lhelge.se/wiki/install/
# The rootless podman API socket of this same user (ADR-0002). Requires= stops hoster when the
# socket goes away; After= makes the socket listen before hoster connects to it.
Requires=podman.socket
After=podman.socket

[Service]
# hoster sends READY=1 once the proxy is listening and the deploy engine runs
# (docs/architecture.md section 4). Only the main process may notify.
Type=notify
NotifyAccess=main
# The versioned binary layout (ADR-0052): `current` links to versions/vX.Y.Z, which install.sh,
# `hoster update` and `hoster rollback` switch atomically.
ExecStart=%h/.local/lib/hoster/current/hoster run

# The admin's GitHub handle (ADR-0021). It is read from the environment only. Override it in a
# drop-in (`systemctl --user edit hoster`) so an upgraded unit file does not reset it:
#   [Service]
#   Environment=HOSTER_ADMIN_GITHUB=octocat
# The placeholder below is not a valid handle, so hoster refuses to start until it is set.
Environment=HOSTER_ADMIN_GITHUB=<your-github-handle>
# Environment=RUST_LOG=hoster=debug

# The GitHub OAuth App's client id and secret for the admin login (ADR-0031), as systemd
# credentials (or set web.github_client_id_file / web.github_client_secret_file in hoster.toml).
# Keep the files 0600; set these in the drop-in too:
#   LoadCredential=github_client_id:%h/.config/hoster/github_client_id
#   LoadCredential=github_client_secret:%h/.config/hoster/github_client_secret
# Optionally, the secret-store key (ADR-0029) as the credential `secret_key` (one line of base64,
# 32 bytes) instead of the generated key file, e.g. from systemd-creds (systemd >= 256):
#   LoadCredentialEncrypted=secret_key:%h/.config/hoster/secret_key.cred

Restart=always
RestartSec=2s
# Startup reconciles containers and may pull images, which can take a while (architecture.md
# section 4, steps 4-5).
TimeoutStartSec=5min
# On SIGTERM hoster drains the proxy for proxy.grace_period (default 10s) and then waits
# proxy.graceful_shutdown_timeout (default 5s) for Pingora's runtimes. TimeoutStopSec must stay
# above their sum plus the time to persist in-flight deploys; raise it with the two settings.
TimeoutStopSec=45s
# hoster is one process; app containers belong to podman/conmon in podman's own cgroup, so
# stopping hoster never stops them (ADR-0034).
KillMode=mixed
# Open files (ADR-0065). hoster raises its own soft limit to 16384 at startup as well, so an
# older copy of this unit gets it too; the proxy refuses new clients at 4096 open descriptors
# (a quarter of the limit, if the hard limit keeps it lower), leaving the rest to hoster.
LimitNOFILE=16384

# ---- Hardening (best-effort, ADR-0023) ----
# A user manager has no privileges, so only directives it can apply as the hoster user work
# here. Filesystem and kernel protections are set up in a user namespace (systemd implies
# PrivateUsers= for them in user units). https://docs.hoster.lhelge.se/wiki/install/#hardening lists what is not available.
#
# No directive here may drop capabilities (CapabilityBoundingSet=, PrivateDevices=,
# ProtectKernelModules=, ProtectKernelLogs=, ProtectClock=): with
# kernel.apparmor_restrict_unprivileged_userns=1 (Ubuntu >= 23.10) the user namespace has no
# capabilities, dropping them fails and the unit cannot start (218/CAPABILITIES). hoster has no
# capabilities on the host anyway, NoNewPrivileges= keeps it that way, and SystemCallFilter=
# ~@privileged blocks module loading, clock changes and raw I/O. On such hosts systemd also
# skips the namespace-based directives below without failing; `hoster doctor` reports it
# (unit_sandbox, OQ-36).
NoNewPrivileges=yes
# Made explicit: a user namespace that maps only hoster's own uid/gid (and root).
PrivateUsers=yes
UMask=0077
PrivateTmp=yes
PrivateIPC=yes
KeyringMode=private
ProtectSystem=strict
ProtectHome=read-only
# The state directory (state_dir, default $XDG_DATA_HOME/hoster), the configuration directory,
# where hoster generates the secret-store key file on first start (ADR-0029), and the binary
# layout, which self-update writes (ADR-0052). All must exist before the first start; change
# this line too if state_dir is moved.
ReadWritePaths=%h/.local/share/hoster %h/.config/hoster %h/.local/lib/hoster
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# Unix sockets (podman API, admin socket, sd_notify) and TCP over IPv4/IPv6.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
